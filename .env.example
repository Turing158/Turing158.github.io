# GitHub Configuration
VITE_GITHUB_OWNER=your-github-username
VITE_GITHUB_REPO=your-repo-name

# Gitalk OAuth App (https://github.com/settings/applications/new)
VITE_GITALK_CLIENT_ID=your-client-id
VITE_GITALK_CLIENT_SECRET=your-client-secret

# 统一后端基址 —— 合并后的 Cloudflare Worker（域名池首项）
# 浏览量 / Gitee 动态 / GitHub REST 代理 / GitHub 用户信息 / Gitalk OAuth token
# / Cline 模型目录 / 友链读写 全部挂在这一个域名下，按路径前缀区分。
VITE_BACKEND_BASE=https://api.turing158.dpdns.org

# 后端域名池（可选，逗号分隔，顺序即优先级）
# 这些域名各自部署了同一个 Worker，但分属不同 Cloudflare 账号（免费额度按账号计：
# 10 万次/天，00:00 UTC 重置）。任一域名额度耗尽（Error 1027）时前端会自动切到下一个。
# 不配置时默认为：VITE_BACKEND_BASE + 下列 4 个内置备用域名。
# ⚠️ 池内每个域名都必须部署了同一个合并版 Worker，否则切过去会大面积 404。
# VITE_BACKEND_POOL=https://api.turing158.dpdns.org,https://api.turing158.de5.net,https://api.friendlink.de5.net,https://api.github-proxy.de5.net,https://api.add-friendlink.de5.net

# 以下端点默认由 VITE_BACKEND_BASE 派生，通常无需配置（仅在需要指向别处时才覆盖）
# VITE_GITHUB_API_BASE=https://api.turing158.dpdns.org/github/api
# VITE_GITHUB_USER_API=https://api.turing158.dpdns.org/github/user
# VITE_CLINE_API_BASE=https://api.turing158.dpdns.org/cline/model/recommended
# VITE_CLINE_ALL_API=https://api.turing158.dpdns.org/cline/model/all
# VITE_API_BASE=https://api.turing158.dpdns.org/article
