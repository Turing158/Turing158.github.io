# GitHub Configuration
VITE_GITHUB_OWNER=your-github-username
VITE_GITHUB_REPO=your-repo-name

# Gitalk OAuth App (https://github.com/settings/applications/new)
VITE_GITALK_CLIENT_ID=your-client-id
VITE_GITALK_CLIENT_SECRET=your-client-secret

# Cline 工具（默认走 tool-proxy；用环境变量可覆盖端点地址）
# VITE_CLINE_API_BASE=https://tool-proxy.turing158.de5.net/cline/model/recommended
# VITE_CLINE_ALL_API=https://tool-proxy.turing158.de5.net/cline/model/all
